# AI Inbox Triage Agent Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Mock Mode: Set to "true" for deterministic offline testing
# When enabled, uses rule-based classification instead of LLM API calls
MOCK_MODE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/inbox_triage.db

# Server
HOST=0.0.0.0
PORT=8000

# Email Source: "json" (default), "gmail", or "imap"
EMAIL_SOURCE=json
EMAIL_SOURCE_PATH=./data/synthetic_emails.json

# Gmail Configuration (optional, stubbed)
# GMAIL_CREDENTIALS_PATH=./credentials.json
# GMAIL_TOKEN_PATH=./token.json

# IMAP Configuration (optional, stubbed)
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USERNAME=user@example.com
# IMAP_PASSWORD=your-password
